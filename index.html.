
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#080808">
<meta name="description" content="Meetora — Connect. Share. Discover.">
<title>Meetora</title>
<style>
:root {
  --bg:#080808; --panel:#141414; --panel2:#1c1c1c;
  --text:#f7f7f7; --muted:#929292; --line:#292929;
  --accent:#fff; --radius:20px;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Manrope,Arial,sans-serif;min-height:100vh}
button,input{font:inherit}
button{cursor:pointer;color:inherit}
.app{max-width:560px;margin:auto;min-height:100vh;padding-bottom:90px}
header{padding:22px 20px 14px;display:flex;align-items:center;justify-content:space-between}
.brand{font-size:25px;font-weight:850;letter-spacing:-1.5px}
.brand span{color:#888}
.avatar{width:42px;height:42px;border-radius:15px;background:#fff;color:#080808;display:grid;place-items:center;font-size:19px;font-weight:900}
main{padding:10px 20px}
.page{display:none}.page.active{display:block}
.eyebrow{font-size:12px;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase}
h1{font-size:30px;letter-spacing:-1.3px;margin:8px 0 5px}
h2{font-size:19px;margin:0 0 14px}
p{color:var(--muted);line-height:1.5}
.section{margin-top:28px}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.section-head h2{margin:0}
.link{background:none;border:0;color:var(--muted);font-size:13px}
.hero{padding:22px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(135deg,#1c1c1c,#101010);margin-top:20px}
.hero h2{font-size:22px;margin:8px 0}
.hero p{font-size:14px;margin:0 0 17px}
.pill{border:0;background:#fff;color:#080808;border-radius:30px;padding:11px 17px;font-weight:750}
.stats{display:flex;gap:9px;margin-top:17px}
.stat{flex:1;background:var(--panel);border:1px solid var(--line);padding:13px;border-radius:16px}
.stat strong{display:block;font-size:20px}.stat small{color:var(--muted)}
.moments{display:flex;gap:14px;overflow:auto;padding-bottom:5px}
.moment{min-width:65px;text-align:center;font-size:12px;color:var(--muted)}
.moment-circle{height:58px;width:58px;border:1px solid #777;border-radius:21px;display:grid;place-items:center;font-size:22px;margin:0 auto 7px;background:var(--panel)}
.moment:first-child .moment-circle{background:#fff;color:#080808}
.quick{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.quick button{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:17px;text-align:left;min-height:90px}
.quick b{display:block;margin-bottom:6px}.quick small{color:var(--muted)}
.chat-list{display:grid;gap:9px}
.chat{display:flex;align-items:center;gap:13px;padding:13px;background:var(--panel);border:1px solid var(--line);border-radius:17px;text-align:left;width:100%}
.chat-avatar{width:47px;height:47px;border-radius:16px;background:#292929;display:grid;place-items:center;font-weight:800}
.chat-info{flex:1;min-width:0}.chat-info b{display:block}.chat-info small{color:var(--muted)}
.time{font-size:11px;color:var(--muted)}
.empty{padding:35px 18px;text-align:center;border:1px dashed #444;border-radius:20px;color:var(--muted)}
.profile-card{text-align:center;padding:28px 18px;background:var(--panel);border:1px solid var(--line);border-radius:22px}
.big-avatar{width:82px;height:82px;border-radius:27px;background:#fff;color:#080808;display:grid;place-items:center;font-size:30px;font-weight:900;margin:0 auto 15px}
.id-tag{display:inline-block;padding:8px 12px;border:1px solid var(--line);border-radius:30px;color:var(--muted);font-size:12px}
.settings-list{display:grid;gap:9px}
.setting{display:flex;justify-content:space-between;align-items:center;padding:16px;background:var(--panel);border:1px solid var(--line);border-radius:15px}
.setting span{color:var(--muted);font-size:13px}
select{background:#222;color:#fff;border:1px solid #444;border-radius:10px;padding:8px;max-width:145px}
.bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:560px;display:grid;grid-template-columns:repeat(4,1fr);padding:10px 9px calc(10px + env(safe-area-inset-bottom));background:rgba(10,10,10,.96);border-top:1px solid var(--line);backdrop-filter:blur(15px);z-index:5}
.nav{border:0;background:none;color:#777;padding:7px 2px;font-size:11px;display:grid;gap:5px;justify-items:center}
.nav i{font-style:normal;font-size:20px}.nav.active{color:#fff}
input{width:100%;padding:14px;border-radius:13px;background:#1c1c1c;border:1px solid #383838;color:#fff;margin:8px 0}
.light{--bg:#f4f4f4;--panel:#fff;--panel2:#eee;--text:#111;--muted:#666;--line:#ddd;--accent:#111}
.light .hero{background:linear-gradient(135deg,#fff,#e9e9e9)}
.light .bottom{background:rgba(245,245,245,.96)}
.light .nav.active{color:#111}
.light .pill{background:#111;color:#fff}
.light .moment:first-child .moment-circle{background:#111;color:#fff}
.light select,.light input{background:#fff;color:#111}
@media(min-width:600px){body{background:#111}.app{border-left:1px solid #222;border-right:1px solid #222}}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="brand">meetora<span>.</span></div>
  <div class="avatar">M</div>
</header>
<main>
<section class="page active" id="home">
  <div class="eyebrow" data-i="welcome">WELCOME BACK</div>
  <h1 data-i="yourday">Your day, your people.</h1>
  <p data-i="subtitle">A little closer to the people who matter.</p>
  <div class="hero">
    <div class="eyebrow">MEETORA / 01</div>
    <h2 data-i="heroTitle">Make today meaningful.</h2>
    <p data-i="heroText">Catch up, share a moment, or start a conversation.</p>
    <button class="pill" onclick="go('chats')" data-i="openChats">Open chats ↗</button>
  </div>
  <div class="stats">
    <div class="stat"><strong>01</strong><small data-i="yourSpace">Your space</small></div>
    <div class="stat"><strong>∞</strong><small data-i="connections">Connections</small></div>
  </div>
  <div class="section">
    <div class="section-head"><h2>Meetora Moments</h2><button class="link" onclick="go('profile')" data-i="yourMoments">Your moments</button></div>
    <div class="moments">
      <div class="moment"><div class="moment-circle">＋</div><span data-i="addStory">Add yours</span></div>
      <div class="moment"><div class="moment-circle">✦</div><span>Discover</span></div>
      <div class="moment"><div class="moment-circle">◌</div><span>Friends</span></div>
      <div class="moment"><div class="moment-circle">⌁</div><span>Today</span></div>
    </div>
  </div>
  <div class="section">
    <div class="section-head"><h2 data-i="quickConnect">Quick Connect</h2></div>
    <div class="quick">
      <button onclick="go('chats')"><b>✉ Messages</b><small data-i="sayHello">Say hello to someone</small></button>
      <button onclick="go('ai')"><b>✧ AI Helper</b><small data-i="ideas">Ideas and assistance</small></button>
    </div>
  </div>
  <div class="section">
    <div class="section-head"><h2 data-i="recentChats">Recent chats</h2><button class="link" onclick="go('chats')" data-i="seeAll">See all</button></div>
    <div class="chat-list">
      <button class="chat" onclick="go('chats')"><div class="chat-avatar">M</div><div class="chat-info"><b>Meetora Team</b><small data-i="welcomeChat">Welcome to Meetora</small></div><span class="time">Now</span></button>
    </div>
  </div>
</section>

<section class="page" id="chats">
  <div class="eyebrow">MEETORA / 02</div><h1 data-i="chatsTitle">Your chats</h1>
  <p data-i="chatsSub">Conversations start here.</p>
  <input id="search" placeholder="Search chats..." oninput="filterChats()">
  <div class="chat-list" id="chatList">
    <button class="chat"><div class="chat-avatar">M</div><div class="chat-info"><b>Meetora Team</b><small data-i="welcomeChat">Welcome to Meetora</small></div><span class="time">Now</span></button>
    <button class="chat"><div class="chat-avatar">✦</div><div class="chat-info"><b>New connections</b><small data-i="soon">Your conversations will appear here</small></div></button>
  </div>
  <div class="section empty" data-i="chatNote">This is a preview. Real messaging will be connected in a later development stage.</div>
</section>

<section class="page" id="ai">
  <div class="eyebrow">MEETORA / 03</div><h1>AI Helper</h1>
  <p data-i="aiSub">A thoughtful space for ideas, questions and creativity.</p>
  <div class="hero"><div class="big-avatar">✧</div><h2 data-i="aiHello">Hello. What are we exploring?</h2><p data-i="aiText">Your personal AI space is being prepared.</p></div>
  <div class="section quick">
    <button onclick="aiPrompt('Give me a creative idea')"><b>✦ Creative ideas</b><small>Find inspiration</small></button>
    <button onclick="aiPrompt('Help me plan my day')"><b>◷ Plan my day</b><small>Organise your thoughts</small></button>
  </div>
  <input id="aiInput" placeholder="Write a message...">
  <button class="pill" onclick="sendAI()" data-i="send">Send</button>
  <p id="aiReply"></p>
</section>

<section class="page" id="profile">
  <div class="eyebrow">MEETORA / 04</div><h1 data-i="profileTitle">Your profile</h1>
  <div class="profile-card section">
    <div class="big-avatar">M</div>
    <h2 id="profileName">Meetora User</h2>
    <div class="id-tag">Meetora ID · @meetora_user</div>
    <p data-i="profileHint">Your identity. Your space.</p>
    <button class="pill" onclick="editName()" data-i="editProfile">Edit profile</button>
  </div>
  <div class="section section-head"><h2 data-i="settings">Settings</h2></div>
  <div class="settings-list">
    <div class="setting"><b data-i="language">Language</b><select id="language" onchange="setLanguage(this.value)"><option value="en">English</option><option value="uk">Українська</option><option value="ru">Русский</option><option value="pl">Polski</option><option value="de">Deutsch</option><option value="es">Español</option><option value="fr">Français</option></select></div>
    <div class="setting"><b data-i="appearance">Appearance</b><select id="theme" onchange="setTheme(this.value)"><option value="dark">Dark</option><option value="light">Light</option></select></div>
    <div class="setting"><b data-i="privacy">Privacy</b><span>Coming soon</span></div>
    <div class="setting"><b data-i="security">Security</b><span>Coming soon</span></div>
    <div class="setting"><b data-i="storage">Storage</b><span>Coming soon</span></div>
  </div>
</section>
</main>
<nav class="bottom">
  <button class="nav active" data-page="home" onclick="go('home')"><i>⌂</i><span>Home</span></button>
  <button class="nav" data-page="chats" onclick="go('chats')"><i>▤</i><span>Chats</span></button>
  <button class="nav" data-page="ai" onclick="go('ai')"><i>✧</i><span>AI Helper</span></button>
  <button class="nav" data-page="profile" onclick="go('profile')"><i>◉</i><span>Profile</span></button>
</nav>
</div>
<script>
const translations={
en:{welcome:"WELCOME BACK",yourday:"Your day, your people.",subtitle:"A little closer to the people who matter.",heroTitle:"Make today meaningful.",heroText:"Catch up, share a moment, or start a conversation.",openChats:"Open chats ↗",yourSpace:"Your space",connections:"Connections",yourMoments:"Your moments",addStory:"Add yours",quickConnect:"Quick Connect",sayHello:"Say hello to someone",ideas:"Ideas and assistance",recentChats:"Recent chats",seeAll:"See all",welcomeChat:"Welcome to Meetora",chatsTitle:"Your chats",chatsSub:"Conversations start here.",soon:"Your conversations will appear here",chatNote:"This is a preview. Real messaging will be connected in a later development stage.",aiSub:"A thoughtful space for ideas, questions and creativity.",aiHello:"Hello. What are we exploring?",aiText:"Your personal AI space is being prepared.",send:"Send",profileTitle:"Your profile",profileHint:"Your identity. Your space.",editProfile:"Edit profile",settings:"Settings",language:"Language",appearance:"Appearance",privacy:"Privacy",security:"Security",storage:"Storage"},
uk:{welcome:"З ПОВЕРНЕННЯМ",yourday:"Твій день, твої люди.",subtitle:"Будь ближче до тих, хто важливий.",heroTitle:"Зроби сьогодні особливим.",heroText:"Спілкуйся, ділися моментами та починай розмови.",openChats:"Відкрити чати ↗",yourSpace:"Твій простір",connections:"Зв'язки",yourMoments:"Твої моменти",addStory:"Додати",quickConnect:"Швидкий зв'язок",sayHello:"Привітай когось",ideas:"Ідеї та допомога",recentChats:"Останні чати",seeAll:"Усі",welcomeChat:"Ласкаво просимо до Meetora",chatsTitle:"Твої чати",chatsSub:"Тут починається спілкування.",soon:"Тут з'являться твої розмови",chatNote:"Це демонстрація. Справжні повідомлення підключимо пізніше.",aiSub:"Простір для ідей, запитань і творчості.",aiHello:"Привіт! Що дослідимо?",aiText:"Твій особистий AI-простір готується.",send:"Надіслати",profileTitle:"Твій профіль",profileHint:"Твоя особистість. Твій простір.",editProfile:"Редагувати профіль",settings:"Налаштування",language:"Мова",appearance:"Вигляд",privacy:"Приватність",security:"Безпека",storage:"Сховище"},
ru:{welcome:"С ВОЗВРАЩЕНИЕМ",yourday:"Твой день, твои люди.",subtitle:"Будь ближе к тем, кто важен.",heroTitle:"Сделай сегодняшний день особенным.",heroText:"Общайся, делись моментами и начинай разговоры.",openChats:"Открыть чаты ↗",yourSpace:"Твоё пространство",connections:"Связи",yourMoments:"Твои моменты",addStory:"Добавить",quickConnect:"Быстрая связь",sayHello:"Поздоровайся с кем-нибудь",ideas:"Идеи и помощь",recentChats:"Недавние чаты",seeAll:"Все",welcomeChat:"Добро пожаловать в Meetora",chatsTitle:"Твои чаты",chatsSub:"Здесь начинается общение.",soon:"Здесь появятся твои разговоры",chatNote:"Это демонстрация. Настоящие сообщения подключим позже.",aiSub:"Пространство для идей, вопросов и творчества.",aiHello:"Привет! Что изучим?",aiText:"Твоё личное пространство AI готовится.",send:"Отправить",profileTitle:"Твой профиль",profileHint:"Твоя личность. Твоё пространство.",editProfile:"Изменить профиль",settings:"Настройки",language:"Язык",appearance:"Внешний вид",privacy:"Приватность",security:"Безопасность",storage:"Хранилище"}
};
function go(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('active',n.dataset.page===id));window.scrollTo(0,0)}
function setLanguage(lang){localStorage.setItem('meetora-language',lang);const t=translations[lang]||translations.en;document.querySelectorAll('[data-i]').forEach(el=>{const k=el.dataset.i;if(t[k])el.textContent=t[k]});document.documentElement.lang=lang}
function setTheme(theme){document.body.classList.toggle('light',theme==='light');localStorage.setItem('meetora-theme',theme)}
function editName(){const n=prompt('Enter your display name:');if(n&&n.trim()){document.getElementById('profileName').textContent=n.trim();localStorage.setItem('meetora-name',n.trim())}}
function filterChats(){const q=document.getElementById('search').value.toLowerCase();document.querySelectorAll('#chatList .chat').forEach(c=>c.style.display=c.textContent.toLowerCase().includes(q)?'flex':'none')}
function aiPrompt(t){document.getElementById('aiInput').value=t}
function sendAI(){const v=document.getElementById('aiInput').value.trim();if(!v)return;document.getElementById('aiReply').textContent='AI Helper is a preview. Connect an AI service in a future stage to receive real answers.';document.getElementById('aiInput').value=''}
document.getElementById('language').value=localStorage.getItem('meetora-language')||'en';setLanguage(document.getElementById('language').value);
document.getElementById('theme').value=localStorage.getItem('meetora-theme')||'dark';setTheme(document.getElementById('theme').value);
document.getElementById('profileName').textContent=localStorage.getItem('meetora-name')||'Meetora User';
</script>
</body>
</html>
