
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080808">
<meta name="description" content="Meetora — Connect. Share. Discover.">
<link rel="manifest" href="./manifest.json">
<title>Meetora</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

:root {
  --bg: #080808;
  --panel: #121212;
  --panel2: #1b1b1b;
  --text: #ffffff;
  --muted: #858585;
  --border: #292929;
  --accent: #ffffff;
}

body.light {
  --bg: #f5f5f5;
  --panel: #ffffff;
  --panel2: #eeeeee;
  --text: #111111;
  --muted: #777777;
  --border: #dddddd;
  --accent: #111111;
}

body {
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding-bottom: 90px;
  transition: .2s;
}

header {
  height: 65px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  background: var(--bg);
  z-index: 10;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1.5px;
}

.logo span {
  color: var(--muted);
}

.header-icon {
  background: var(--panel);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 10px 13px;
  border-radius: 13px;
  font-size: 17px;
}

main {
  max-width: 600px;
  margin: auto;
  padding: 22px 17px;
}

.page {
  display: none;
  animation: appear .2s ease;
}

.page.active {
  display: block;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

h1 {
  font-size: 27px;
  margin-bottom: 7px;
}

.subtitle {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 25px;
}

.section-title {
  font-size: 17px;
  font-weight: 700;
  margin: 25px 0 14px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 17px;
  border-radius: 18px;
  margin-bottom: 12px;
}

.stories {
  display: flex;
  gap: 13px;
  overflow-x: auto;
  padding: 5px 0 12px;
}

.story {
  min-width: 65px;
  text-align: center;
  font-size: 11px;
  color: var(--muted);
}

.story-circle {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  border: 2px solid var(--text);
  background: var(--panel2);
  display: grid;
  place-items: center;
  margin: 0 auto 7px;
  font-size: 21px;
}

.story.add .story-circle {
  background: var(--text);
  color: var(--bg);
}

.moment {
  min-height: 130px;
  background: linear-gradient(135deg, #252525, #101010);
  border-radius: 17px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  margin-bottom: 12px;
  border: 1px solid var(--border);
}

.moment strong {
  font-size: 19px;
}

.moment p {
  color: #aaa;
  font-size: 12px;
  margin-top: 5px;
}

.quick-connect {
  display: flex;
  gap: 9px;
}

.quick-connect button {
  flex: 1;
}

button {
  cursor: pointer;
  border: none;
}

.btn {
  padding: 13px;
  border-radius: 13px;
  background: var(--text);
  color: var(--bg);
  font-weight: 700;
}

.btn-secondary {
  background: var(--panel2);
  color: var(--text);
  border: 1px solid var(--border);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.avatar {
  width: 45px;
  height: 45px;
  border-radius: 15px;
  background: var(--panel2);
  display: grid;
  place-items: center;
  font-weight: bold;
  font-size: 17px;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-info strong {
  font-size: 14px;
}

.user-info p {
  color: var(--muted);
  font-size: 12px;
  margin-top: 5px;
}

.online {
  width: 8px;
  height: 8px;
  background: #75d99a;
  border-radius: 50%;
}

.search {
  width: 100%;
  background: var(--panel);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 14px;
  border-radius: 13px;
  margin-bottom: 15px;
  outline: none;
}

.chat-preview {
  display: flex;
  flex-direction: column;
  height: 360px;
  gap: 12px;
  overflow-y: auto;
  padding: 12px 0;
}

.message {
  background: var(--panel2);
  padding: 12px 15px;
  border-radius: 15px;
  max-width: 80%;
  font-size: 14px;
}

.message.mine {
  align-self: flex-end;
  background: var(--text);
  color: var(--bg);
}

.chat-input {
  display: flex;
  gap: 8px;
}

.chat-input input {
  flex: 1;
  min-width: 0;
  background: var(--panel);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 13px;
  padding: 13px;
  outline: none;
}

.chat-input button {
  background: var(--text);
  color: var(--bg);
  border-radius: 13px;
  padding: 0 17px;
}

.ai-box {
  text-align: center;
  padding: 35px 15px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
}

.ai-symbol {
  font-size: 42px;
  margin-bottom: 15px;
}

.profile-top {
  text-align: center;
  padding: 25px 10px;
}

.profile-avatar {
  width: 85px;
  height: 85px;
  border-radius: 28px;
  background: var(--text);
  color: var(--bg);
  display: grid;
  place-items: center;
  font-size: 30px;
  font-weight: bold;
  margin: 0 auto 15px;
}

.setting {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 17px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}

.setting select,
.setting input {
  max-width: 145px;
  background: var(--panel2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 9px;
  padding: 8px;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--bg);
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-around;
  padding: 11px 5px calc(11px + env(safe-area-inset-bottom));
  z-index: 20;
}

.nav-item {
  background: transparent;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  min-width: 60px;
}

.nav-item .nav-icon {
  font-size: 21px;
}

.nav-item.active {
  color: var(--text);
  font-weight: bold;
}

.small-note {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
  margin-top: 13px;
}

@media (min-width: 700px) {
  main { padding-top: 35px; }
}
</style>
</head>

<body>

<header>
  <div class="logo">meetora<span>.</span></div>
  <button class="header-icon" onclick="showPage('profile')">⚙</button>
</header>

<main>

<section class="page active" id="home">
  <h1 id="welcome">Welcome to Meetora</h1>
  <p class="subtitle">Your space. Your people. Your moments.</p>

  <div class="section-title">Your Day</div>
  <div class="stories">
    <div class="story add" onclick="demo('Stories')">
      <div class="story-circle">＋</div>
      Add story
    </div>
    <div class="story">
      <div class="story-circle">M</div>
      Meetora
    </div>
    <div class="story">
      <div class="story-circle">A</div>
      Alex
    </div>
    <div class="story">
      <div class="story-circle">J</div>
      Jordan
    </div>
    <div class="story">
      <div class="story-circle">S</div>
      Sam
    </div>
  </div>

  <div class="section-title">Meetora Moments</div>
  <div class="moment">
    <strong>Share your moment.</strong>
    <p>A little part of your day can mean a lot.</p>
  </div>

  <div class="section-title">Quick Connect</div>
  <div class="quick-connect">
    <button class="btn" onclick="showPage('chats')">Open chats</button>
    <button class="btn btn-secondary" onclick="demo('Quick Connect')">Discover</button>
  </div>

  <div class="section-title">Recent activity</div>
  <div class="card">
    <div class="user-row">
      <div class="avatar">M</div>
      <div class="user-info">
        <strong>Meetora Team</strong>
        <p>Welcome to your new space.</p>
      </div>
    </div>
    <p class="small-note">This is a preview. Real accounts and online activity will be connected later.</p>
  </div>
</section>

<section class="page" id="chats">
  <h1>Chats</h1>
  <p class="subtitle">Your conversations in one place.</p>

  <input class="search" id="chatSearch" placeholder="Search conversations..." oninput="filterChats()">

  <div id="chatList">
    <div class="user-row" onclick="openChat('Alex')">
      <div class="avatar">A</div>
      <div class="user-info">
        <strong>Alex</strong>
        <p>Hey! Welcome to Meetora.</p>
      </div>
      <span class="online"></span>
    </div>

    <div class="user-row" onclick="openChat('Jordan')">
      <div class="avatar">J</div>
      <div class="user-info">
        <strong>Jordan</strong>
        <p>See you soon!</p>
      </div>
    </div>

    <div class="user-row" onclick="openChat('Sam')">
      <div class="avatar">S</div>
      <div class="user-info">
        <strong>Sam</strong>
        <p>Let's talk later.</p>
      </div>
    </div>
  </div>

  <div id="chatWindow" style="display:none">
    <button class="btn btn-secondary" onclick="closeChat()">← Back</button>
    <div class="section-title" id="chatName">Chat</div>
    <div class="chat-preview" id="messages">
      <div class="message">Welcome to Meetora!</div>
    </div>
    <div class="chat-input">
      <input id="messageInput" placeholder="Write a message..." onkeydown="if(event.key==='Enter')sendMessage()">
      <button onclick="sendMessage()">➤</button>
    </div>
    <p class="small-note">Demo chat. Messages are only stored temporarily in this page.</p>
  </div>
</section>

<section class="page" id="ai">
  <h1>AI Helper</h1>
  <p class="subtitle">A smarter space inside Meetora.</p>

  <div class="ai-box">
    <div class="ai-symbol">✳</div>
    <h2>Meetora AI</h2>
    <p class="small-note">Your assistant for ideas, creativity and everyday questions.</p>
    <button class="btn" style="width:100%;margin-top:22px" onclick="demo('AI Helper')">Start conversation</button>
  </div>

  <div class="section-title">What you can do</div>
  <div class="card">✦ Get creative ideas</div>
  <div class="card">✦ Ask everyday questions</div>
  <div class="card">✦ Organize your thoughts</div>
  <p class="small-note">AI connection will be added in a future development stage.</p>
</section>

<section class="page" id="profile">
  <h1>Profile</h1>
  <p class="subtitle">Your Meetora identity.</p>

  <div class="card profile-top">
    <div class="profile-avatar" id="avatarLetter">M</div>
    <h2 id="profileName">Meetora User</h2>
    <p class="small-note" id="profileId">@meetora_user</p>
    <button class="btn btn-secondary" style="margin-top:15px" onclick="editProfile()">Edit profile</button>
  </div>

  <div class="section-title">Settings</div>
  <div class="card">
    <div class="setting">
      <span>Account</span>
      <span>›</span>
    </div>
    <div class="setting">
      <span>Privacy</span>
      <span>›</span>
    </div>
    <div class="setting">
      <span>Security</span>
      <span>›</span>
    </div>
    <div class="setting">
      <span>Notifications</span>
      <span>›</span>
    </div>
    <div class="setting">
      <span>Language</span>
      <select id="language" onchange="changeLanguage()">
        <option value="en">English</option>
        <option value="uk">Українська</option>
        <option value="ru">Русский</option>
        <option value="pl">Polski</option>
        <option value="de">Deutsch</option>
        <option value="es">Español</option>
        <option value="fr">Français</option>
      </select>
    </div>
    <div class="setting">
      <span>Appearance</span>
      <select id="appearance" onchange="changeTheme()">
        <option value="dark">Dark</option>
        <option value="light">Light</option>
      </select>
    </div>
    <div class="setting">
      <span>Storage</span>
      <button class="btn btn-secondary" onclick="clearStorage()">Manage</button>
    </div>
  </div>

  <div class="section-title">Meetora</div>
  <div class="card">
    <strong>Meetora ID</strong>
    <p class="small-note">Your unique identity across Meetora.</p>
    <p style="margin-top:10px">@meetora_user</p>
  </div>
  <p class="small-note">Version 0.1.0 · Meetora Preview</p>
</section>

</main>

<nav class="bottom-nav">
  <button class="nav-item active" data-page="home" onclick="showPage('home')">
    <span class="nav-icon">⌂</span>
    <span>Home</span>
  </button>
  <button class="nav-item" data-page="chats" onclick="showPage('chats')">
    <span class="nav-icon">▢</span>
    <span>Chats</span>
  </button>
  <button class="nav-item" data-page="ai" onclick="showPage('ai')">
    <span class="nav-icon">✳</span>
    <span>AI Helper</span>
  </button>
  <button class="nav-item" data-page="profile" onclick="showPage('profile')">
    <span class="nav-icon">◉</span>
    <span>Profile</span>
  </button>
</nav>

<script>
function showPage(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(page).classList.add('active');

  document.querySelectorAll('.nav-item').forEach(item => {
    item.classList.toggle('active', item.dataset.page === page);
  });

  window.scrollTo(0, 0);
}

function demo(feature) {
  alert(feature + ' is part of the Meetora preview. This feature will be connected later.');
}

function filterChats() {
  const query = document.getElementById('chatSearch').value.toLowerCase();
  document.querySelectorAll('#chatList .user-row').forEach(row => {
    row.style.display = row.innerText.toLowerCase().includes(query) ? 'flex' : 'none';
  });
}

let currentChat = '';

function openChat(name) {
  currentChat = name;
  document.getElementById('chatList').style.display = 'none';
  document.getElementById('chatSearch').style.display = 'none';
  document.getElementById('chatWindow').style.display = 'block';
  document.getElementById('chatName').innerText = name;
}

function closeChat() {
  document.getElementById('chatList').style.display = 'block';
  document.getElementById('chatSearch').style.display = 'block';
  document.getElementById('chatWindow').style.display = 'none';
}

function sendMessage() {
  const input = document.getElementById('messageInput');
  const value = input.value.trim();
  if (!value) return;

  const message = document.createElement('div');
  message.className = 'message mine';
  message.textContent = value;
  document.getElementById('messages').appendChild(message);

  input.value = '';
  document.getElementById('messages').scrollTop =
    document.getElementById('messages').scrollHeight;
}

function editProfile() {
  const oldName = localStorage.getItem('meetoraName') || 'Meetora User';
  const newName = prompt('Enter your display name:', oldName);

  if (newName && newName.trim()) {
    localStorage.setItem('meetoraName', newName.trim());
    updateProfile();
  }
}

function updateProfile() {
  const name = localStorage.getItem('meetoraName') || 'Meetora User';
  document.getElementById('profileName').innerText = name;
  document.getElementById('avatarLetter').innerText = name.charAt(0).toUpperCase();
}

function changeTheme() {
  const theme = document.getElementById('appearance').value;
  document.body.classList.toggle('light', theme === 'light');
  localStorage.setItem('meetoraTheme', theme);
}

function changeLanguage() {
  const language = document.getElementById('language').value;
  localStorage.setItem('meetoraLanguage', language);
  alert('Language preference saved. Full translations are coming later.');
}

function clearStorage() {
  if (confirm('Clear Meetora local settings?')) {
    localStorage.removeItem('meetoraName');
    localStorage.removeItem('meetoraTheme');
    localStorage.removeItem('meetoraLanguage');
    location.reload();
  }
}

function loadSettings() {
  const theme = localStorage.getItem('meetoraTheme') || 'dark';
  document.body.classList.toggle('light', theme === 'light');
  document.getElementById('appearance').value = theme;

  document.getElementById('language').value =
    localStorage.getItem('meetoraLanguage') || 'en';

  updateProfile();
}

loadSettings();

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js').catch(error => {
      console.log('Service Worker registration failed:', error);
    });
  });
}
</script>

</body>
</html>
